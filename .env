# Environment Variables Template
# Copy this file to .env in your project root and customize as needed

# =============================================================================
# AI API KEYS
# =============================================================================
# OpenAI API (most AI projects)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude API  
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini API
GOOGLE_API_KEY=your-google-api-key-here

# Hugging Face API
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# =============================================================================
# PROJECT DIRECTORIES
# =============================================================================
# Base directory for project files (customize per project)
PROJECT_BASE_DIRECTORY=/absolute/path/to/your/project

# Common scan directories (Desktop, Downloads, Documents)
SCAN_DIRECTORIES=/Users/ryanthomson/Desktop,/Users/ryanthomson/Downloads,/Users/ryanthomson/Documents

# Output/processed files directory
OUTPUT_DIRECTORY=/absolute/path/to/output

# =============================================================================
# AI MODEL SETTINGS
# =============================================================================
# Default model for text generation
DEFAULT_MODEL=gpt-4

# Model temperature (0.0-1.0)
MODEL_TEMPERATURE=0.7

# Max tokens for responses
MAX_TOKENS=2000

# =============================================================================
# DEVELOPMENT SETTINGS  
# =============================================================================
# Run in dry-run mode by default (true/false)
DRY_RUN=true

# Debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# RUNPOD SETTINGS (for deployed services)
# =============================================================================
# RunPod API key
RUNPOD_API_KEY=your-runpod-api-key-here

# RunPod endpoint ID
RUNPOD_ENDPOINT_ID=your-endpoint-id

# =============================================================================
# DATABASE/STORAGE
# =============================================================================
# Vector database path (ChromaDB, etc.)
VECTOR_DB_PATH=./vector_store

# SQLite database path
SQLITE_DB_PATH=./data.db

# =============================================================================
# WEB/API SETTINGS
# =============================================================================
# Flask/FastAPI host
HOST=localhost

# Flask/FastAPI port  
PORT=8000

# API base URL
API_BASE_URL=http://localhost:8000

# =============================================================================
# CREATIVE PROJECT SPECIFIC
# =============================================================================
# Audio processing settings
AUDIO_QUALITY=high
AUDIO_FORMAT=wav

# Video processing settings  
VIDEO_QUALITY=1080p
VIDEO_FORMAT=mp4

# Content generation settings
CONTENT_STYLE=professional
CONTENT_LENGTH=medium
