    "routing_rules": {
        "screenshot": {
            "immediate_action": "rename_in_place",
            "cooloff_days": 7,
            "final_destination": "04_VISUAL_ASSETS/Screenshots"
        },
        "audio_unidentified": {
            "destination": "03_SOUND_LIBRARY/_Unsorted"
        },
        "audio_project": {
            "destination": "{project_path}/Audio"
        },
        "contract_client": {
            "destination": "{client_path}/01_Contracts"
        },
        "contract_general": {
            "destination": "01_TALENT_MANAGEMENT/Legal"
        },
        "financial_client": {
            "destination": "{client_path}/02_Finance"
        },
        "financial_general": {
            "destination": "01_TALENT_MANAGEMENT/Financial"
        },
        "unknown": {
            "destination": "00_INBOX/Manual_Review"
        }
    },
    "naming_conventions": {
        "folders": "Title_Case_Underscores",
        "episodes": "EP{##}_Title",
        "chapters": "CH{##}_Title",
        "interludes": "INT{##}_Title",
        "screenshots": "{YYYY-MM-DD}_SS_{keyword1}_{keyword2}_{keyword3}",
        "clients": "LastName_FirstName",
        "forbidden_chars": [
            ":",
            "!",
            "?",
            "'",
            "\""
        ]
    },
    "confidence_thresholds": {
        "auto_move": 0.65,
        "auto_rename": 0.50,
        "manual_review": 0.65,
        "screenshot_immediate_rename": 0.40
    },
    "excluded_patterns": [
        "*_NOAI",
        "*_NOAI/*",
        "*_EXCLUDE",
        "*_EXCLUDE/*",
        "98_OBSIDIAN_VAULT/*",
        ".DS_Store",
        "*.tmp"
    ]
}